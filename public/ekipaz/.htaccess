# Ekipaż – konfiguracja Apache (hosting współdzielony)
DirectoryIndex index.html
Options -Indexes

# Własne reguły – nie dziedziczymy przepisywania adresów z głównej strony
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/ekipaz/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ /ekipaz/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Baza i konfiguracja nigdy nie są serwowane
RedirectMatch 404 ^.*/data/.*$
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db|md|sh|py)$">
  Require all denied
</FilesMatch>
